{
    "name": "walkerchiu/php-point-int",
    "type": "library",
    "authors": [
        {
            "name":  "Walker Chiu",
            "email": "chenjen.chiou@gmail.com"
        }
    ],
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^7.4|^8.0",
        "walkerchiu/php-core-int": "^1.2"
    },
    "require-dev": {
        "orchestra/testbench": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "WalkerChiu\\Point\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WalkerChiu\\Point\\PointServiceProvider"
            ],
            "aliases": {
                "Setting": "WalkerChiu\\Point\\Models\\Entities\\Setting",
                "Wallet":  "WalkerChiu\\Point\\Models\\Entities\\Wallet",
                "Record":  "WalkerChiu\\Point\\Models\\Entities\\Record"
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
